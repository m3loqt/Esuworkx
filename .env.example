# Neon connection string (Postgres). Pick a region close to your users —
# query latency is dominated by physical distance to the DB (e.g. ap-southeast-1
# / Singapore for a Manila-based studio, not the default us-east-1).
DATABASE_URL=

# Resend (email) — admin notification on new order
RESEND_API_KEY=
ADMIN_EMAIL=

# Admin auth
# Base64-encoded bcrypt hash of the admin password (never store plaintext).
# Base64-encoded because Netlify's env system expands `$VAR`-style
# references in values, which mangles a raw bcrypt hash (it's full of `$`).
# Generate with:
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync('your-password', 10)).toString('base64'))"
ADMIN_PASSWORD_HASH=
# Random string used to sign the admin session cookie
SESSION_SECRET=

# Netlify Blobs — auto-detected when deployed on Netlify.
# Only set explicitly if running outside the Netlify build/runtime environment.
NETLIFY_BLOBS_SITE_ID=
